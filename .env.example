# ============================================================================
# CONFIGURACIÓN DE SUPABASE - PORTAL DE TICKETS TECNOCONTROL
# ============================================================================
# Obtén estas credenciales en:
# https://supabase.com/dashboard/project/_/settings/api
#
# 1. Copia este archivo como .env.local:
#    cp .env.example .env.local
# 2. Reemplaza los valores con los de tu proyecto de Supabase.
# ============================================================================

# URL de la instancia de Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key) para consultas del cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de servicio (service_role key) para operaciones administrativas del servidor
# NOTA: Esta clave NUNCA se expone en el cliente/navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
